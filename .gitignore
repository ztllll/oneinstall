# ============================================================
# OneInstall 一键安装器 .gitignore
# 顺序：敏感文件 -> 体积物 -> 运行时产物 -> IDE/OS 杂项
# ============================================================

# ----- 敏感文件（绝对不入库）-----
.env
*.env
secrets.yaml
*.key
*.pem
credentials.*

# ----- Python 体积物 -----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.egg
build/
dist/
.eggs/
pip-wheel-metadata/

# ----- 打包产物 -----
# PyInstaller
*.spec.bak

# Nuitka
*.nuitka-build/
*.build/
installer.build/
installer.dist/
installer.onefile-build/

# 单文件 EXE（体积大，不入库；本地构建产物）
*.exe
!.gitkeep

# ----- 运行时产物 -----
logs/*
!logs/.gitkeep
*.log
screenshots/*
!screenshots/.gitkeep

# ----- 虚拟环境 -----
venv/
.venv/
env/
.conda/

# ----- 测试产物 -----
.pytest_cache/
.coverage
htmlcov/
.tox/
.cache
coverage.xml

# ----- IDE / 编辑器 -----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ----- Node（如果未来加 web 控制面板）-----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ----- 本地配置覆盖 -----
config.local.yaml
configs/local/
